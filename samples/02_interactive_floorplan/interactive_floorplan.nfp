  "metadata": {
    "name": "Interactive Walkable Floor Plan 3D",
    "author": "Neo Realms Interactive",
    "description": "Real-time 3D architectural floor plan with OSC visitor tracking, dynamic avatar positioning, procedural geometry, lighting, and GPU rasterized rendering.",
