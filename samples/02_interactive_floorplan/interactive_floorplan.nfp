        "params": {
          "radius": { "mode": "constant", "expr": "", "val": { "type": "float", "val": 0.5 } },
          "rows": { "mode": "constant", "expr": "", "val": { "type": "int", "val": 16 } },
          "cols": { "mode": "constant", "expr": "", "val": { "type": "int", "val": 16 } }
        }
      },
      {
        "id": 15,
        "name": "avatar_transform",
        "type": "TransformGeomOp",
        "pos": [ -280.0, 150.0 ],
        "params": {
          "translate": { "mode": "expression", "expr": "[op('pos_filter')['x'], 0.5, op('pos_filter')['y']]", "val": { "type": "vec3", "val": [ 0.0, 0.5, 0.0 ] } },
          "rotate": { "mode": "constant", "expr": "", "val": { "type": "vec3", "val": [ 0.0, 0.0, 0.0 ] } },
          "scale": { "mode": "constant", "expr": "", "val": { "type": "vec3", "val": [ 1.0, 1.0, 1.0 ] } }
        }
