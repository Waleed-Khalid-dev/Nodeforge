          "scalar": { "mode": "constant", "expr": "", "val": { "type": "float", "val": 10.0 } },
          "clamp_min": { "mode": "constant", "expr": "", "val": { "type": "float", "val": -10.0 } },
          "clamp_max": { "mode": "constant", "expr": "", "val": { "type": "float", "val": 10.0 } }
