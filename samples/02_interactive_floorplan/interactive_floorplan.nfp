          "type": { "mode": "constant", "expr": "", "val": { "type": "int", "val": 0 } },
          "filter_width": { "mode": "constant", "expr": "", "val": { "type": "float", "val": 0.15 } }
        }
      },
      {
        "id": 13,
        "name": "floor_mesh",
        "type": "GridGeomOp",
        "pos": [ -500.0, -50.0 ],
        "params": {
          "size_x": { "mode": "constant", "expr": "", "val": { "type": "float", "val": 20.0 } },
          "size_y": { "mode": "constant", "expr": "", "val": { "type": "float", "val": 20.0 } },
          "rows": { "mode": "constant", "expr": "", "val": { "type": "int", "val": 20 } },
          "cols": { "mode": "constant", "expr": "", "val": { "type": "int", "val": 20 } }
        }
      },
      {
        "id": 14,
        "name": "avatar_sphere",
        "type": "SphereGeomOp",
