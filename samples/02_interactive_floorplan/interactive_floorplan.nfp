  "root_graph": {
    "nodes": [
      {
        "id": 10,
        "name": "osc_sensor_in",
        "type": "OSCInChanOp",
        "pos": [ -700.0, -300.0 ],
        "params": {
          "port": { "mode": "constant", "expr": "", "val": { "type": "int", "val": 8000 } },
          "address_pattern": { "mode": "constant", "expr": "", "val": { "type": "string", "val": "/tracking/*" } },
          "decay_rate": { "mode": "constant", "expr": "", "val": { "type": "float", "val": 0.0 } }
        }
      },
      {
